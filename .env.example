# PostgreSQL Connection String for Render
# Format: Host=hostname;Port=port;Database=dbname;Username=user;Password=password
ConnectionStrings__DefaultConnection=Host=your-postgres-hostname;Port=5432;Database=taskmanagement_db;Username=your_username;Password=your_password

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# Port (Render automatically sets this)
ASPNETCORE_URLS=http://+:8080

# Admin Seed Configuration
Seed__AdminEmail=admin@taskmanager.com
Seed__AdminPassword=Admin@123
Seed__AdminUserName=admin

# Pagination
Pagination__PageSize=10
